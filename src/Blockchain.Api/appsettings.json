{
  "ConnectionStrings": {
    "Blockchain": "Host=localhost;Port=5432;Database=blockchain;Username=blockchain;Password=local-development-only"
  },
  "BlockCypher": {
    "BaseUrl": "https://api.blockcypher.com/v1/",
    "RequestsPerSecond": 2,
    "RequestsPerHour": 90,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 45,
    "MaxRetries": 1,
    "MaxResponseBytes": 1048576
  },
  "Cors": { "AllowedOrigins": ["http://localhost:5173"] },
  "Swagger": { "Enabled": false },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*"
}
